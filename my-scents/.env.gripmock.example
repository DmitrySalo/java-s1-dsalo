# GripMock Configuration
# This file contains environment variables for GripMock services

# GripMock version
GRIPMOCK_VERSION=latest

# FragranceService configuration
FRAGRANCE_GRPC_PORT=50051
FRAGRANCE_ADMIN_PORT=4771

# Proto files root location (relative to docker-compose.yaml)
# Must point to parent directory containing 'fragrance' folder for imports to work
FRAGRANCE_PROTO_PATH=./my-scents/src/main/proto

# Stubs location (relative to docker-compose.yaml)
FRAGRANCE_STUBS_PATH=./my-scents/gripmock/fragrance/stubs
